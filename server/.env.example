# Vastu.in Real Estate Marketplace — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.

# ---- MySQL Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=vastu_reviews

# ---- Server & Frontend URLs ----
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5500/home_property_discovery/code.html
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# ---- Session Security & Lifetime ----
# Cryptographically strong secret key (at least 32 characters)
SESSION_SECRET=vastu_super_secret_session_key_production_2026_xyz123
# Long-lived persistent session lifetime in days (default: 180 days)
SESSION_LIFETIME_DAYS=180
# Enable reverse proxy trust if deployed behind Nginx, Render, Heroku, Cloudflare, AWS
TRUST_PROXY=1

# ---- Google OAuth 2.0 / OpenID Connect ----
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Required Authorized redirect URI in Google Console: http://127.0.0.1:4000/api/auth/google/callback
# Or for localhost: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://127.0.0.1:4000/api/auth/google/callback

# ---- Email (SMTP) Delivery Configuration ----
# Leave empty for local development (OTPs will be clearly logged to the server terminal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=Vastu.in Authentication <no-reply@vastu.in>

# ---- File Uploads ----
UPLOAD_MAX_BYTES=2097152
UPLOAD_DIR=./uploads

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
